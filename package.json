{
  "name": "llm-reliability-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:compile": "tsx scripts/compile-content.ts",
    "predev": "npm run content:compile",
    "dev": "vinext dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern samples --ignore-pattern docs",
    "lint:editorial": "tsx scripts/lint-editorial.mjs",
    "pretest": "npm run content:compile",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:artifact": "node --test tests/sites-artifact.test.mjs",
    "prebuild": "npm run content:compile",
    "build": "npm run lint:editorial && vinext build",
    "start": "vinext start",
    "review:generate": "tsx scripts/generate-case-review.tsx",
    "review:generate-corpus": "tsx scripts/generate-corpus-review.tsx",
    "review:verify-images": "tsx scripts/verify-review-images.ts",
    "review:serve": "tsx scripts/serve-review.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.20"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@tybys/wasm-util": "0.10.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.28",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "postcss": "^8.5.20",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "3.4.17",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  }
}
